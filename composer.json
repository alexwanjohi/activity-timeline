{
    "name": "lara-zeus/activity-timeline",
    "description": "Add timelines to custom pages or infolist entries effortlessly. Plus, it teams up smoothly with Spatie Activitylog for easy tracking.",
    "keywords": [
        "lara-zeus",
        "laravel",
        "activity-timeline",
        "timeline",
        "filament-infolists",
        "filamentphp"
    ],
    "homepage": "https://github.com/lara-zeus/activity-timeline",
    "support": {
        "issues": "https://github.com/lara-zeus/activity-timeline/issues",
        "source": "https://github.com/lara-zeus/activity-timeline"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jay-Are Ocero",
            "email": "199ocero@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Lara Zeus",
            "email": "info@larazeus.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LaraZeus\\ActivityTimeline\\": "src/",
            "LaraZeus\\ActivityTimeline\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraZeus\\ActivityTimeline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\ActivityTimeline\\ActivityTimelineServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
